shamefully-hoist=true
# Pin the lockfile READ (MUL-4302 build reproducibility, iter-182).
#
# pnpm also reads npm's user-level ~/.npmrc, and on some machines that file
# carries `lockfile=false`. When it does, pnpm silently ignores pnpm-lock.yaml
# and resolves every caret range to "whatever is newest today" — the only
# trace is one WARN line ("The current configuration prohibits to read or
# write a lockfile") in a several-hundred-line install log. A fresh worktree
# then builds against a dependency tree the repo never pinned: in iter-182 this
# installed @tanstack/react-query 5.103.2 where the lock says 5.96.2, and the
# newer version produced a type error that does not exist on the pinned tree.
#
# A repository-level .npmrc takes precedence over the user-level one, so this
# line makes the lock authoritative for every clone without depending on anyone
# remembering a --config.lockfile=true flag. Same failure mode as the floating
# Gradle dependency fixed in iter-181 (fbjni:+), on the other toolchain.
lockfile=true
